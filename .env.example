# Supabase dashboard > Project Settings > API.
# These are PUBLIC browser configuration, never use a service-role/secret key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Google Workspace + Custom GPT: SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://kimo-os-rbcy.vercel.app/api/google/callback
# Base64 of 32 cryptographically random bytes; generate locally with Node crypto.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Optional OS-side AI chat; billed separately from ChatGPT subscriptions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
